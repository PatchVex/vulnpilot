#!/bin/bash
# pre-push: run the test suite before every push.
# Safe to share — contains no absolute paths or machine-specific references.
#
# Setup (one-time per clone):
#   git config core.hooksPath .githooks

set -euo pipefail

# If a virtualenv is active, remove it from PATH so this hook always uses the
# system python3. Temporary or project-local venvs with missing packages must
# not block or break the gate.
if [ -n "${VIRTUAL_ENV:-}" ]; then
    export PATH="${PATH/${VIRTUAL_ENV}\/bin:/}"
    unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT
fi

cd "$(git rev-parse --show-toplevel)"

echo "── pre-push gate ──────────────────────────────────"
echo "Changed since last push:"
git diff --stat @{push}.. 2>/dev/null || git diff --stat HEAD~1 2>/dev/null
echo "───────────────────────────────────────────────────"

python3 -m pytest tests/ -v --tb=short

echo "✓ all tests green — pushing"
